# NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
GUARD_CONTRACT_ID=guard.djume.testnet

# Agent function-call account. Never commit the key.
NEAR_ACCOUNT_ID=agent1.guard.djume.testnet
NEAR_PRIVATE_KEY=ed25519:...
# Or a Near CLI credentials file: {"account_id":"...","private_key":"ed25519:..."}
# NEAR_KEY_FILE=/path/to/.near-credentials/testnet/agent1.guard.djume.testnet.json

# Vault
SANA_GUARD_VAULT_ID=0
# Optional; otherwise read from get_vault
# SANA_GUARD_VAULT_ADDRESS=Fkk515Q2ZKeg3aqkcpSwVvFbDVj8VVDesHwWttbtMbgU
# Optional owner pubkey used only to derive the vault address
# SANA_GUARD_OWNER=DeF8KCnMiARMuEUjc1iD4wGh8g8D7ygSUVGnYw8XMvmB
# SANA_GUARD_VAULT_INDEX=0
# MPC_CONTRACT=v1.signer-prod.testnet
# MPC_DOMAIN_ID=1

# Solana (devnet default)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Safety
SANA_GUARD_ALLOW_MAINNET=false
# Optional server-side ceilings (base units as decimal strings)
# SANA_GUARD_MAX_LAMPORTS_PER_CALL=50000000
# SANA_GUARD_MAX_TOKEN_AMOUNT_PER_CALL=1000000

# Transport: stdio (default) or http
# MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787
# Required when MCP_TRANSPORT=http
# MCP_HTTP_TOKEN=long-random-secret
# MCP_HTTP_ALLOW_PUBLIC=false
# MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# MCP_HTTP_MAX_SESSIONS=32
# MCP_HTTP_SESSION_TTL_MS=1800000
