# NEAR Configuration
RELAY_ACCOUNT_ID=relay.djume.testnet
RELAY_NEAR_PRIVATE_KEY=ed25519:...  # Never commit this key
NEAR_NETWORK=testnet  # testnet or mainnet
NEAR_RPC_URL=https://rpc.testnet.near.org
GUARD_CONTRACT_ID=guard.djume.testnet

# Database (SQLite only). On Railway, mount a volume at this file path
# so daily budgets survive redeploys. Example: /data/relay.db
DATABASE_URL=sqlite:./relay.db

# Security & Limits
RELAY_BALANCE_FLOOR_NEAR=0.5  # Stop accepting requests below this balance
MAX_AGENT_GAS_FUNDING_NEAR=0.5  # Cap for AddAgent gas_funding
GLOBAL_DAILY_BUDGET_NEAR=1.0  # Total NEAR spending limit per day (default: 1 NEAR)
MAX_DEPOSIT_PER_CALL_NEAR=2.0  # Hard cap on any single deposit
OWNER_RATE_LIMIT_PER_HOUR=30  # Max requests per owner per hour
OWNER_DAILY_BUDGET_NEAR=5.0  # Max NEAR per owner per day (deposits + gas)

# Anti-drain gates for CreateVault / AddAgent (ON by default).
# When ADMIN_GATE_ENABLED=true (default) and neither INVITE_TOKEN nor
# OWNER_ALLOWLIST is set, CreateVault and AddAgent are refused (403).
ADMIN_GATE_ENABLED=true
INVITE_TOKEN=  # Require this value in the X-Invite-Token header
OWNER_ALLOWLIST=  # Comma-separated allowed owner pubkeys (base58)
CORS_ORIGINS=  # Comma-separated allowed origins (* for all)

# Server
PORT=3000
NODE_ENV=production  # or development
LOG_LEVEL=info  # trace, debug, info, warn, error

# Optional monitoring
SENTRY_DSN=
