# Required for login. The app builds and shows a missing-config screen without it.
NEXT_PUBLIC_PRIVY_APP_ID=

# Unlinked /design-preview catalog. Off in production unless set to 1.
# Always available when NODE_ENV=development.
NEXT_PUBLIC_ENABLE_DESIGN_PREVIEW=

# Optional Privy client ID (some Privy apps require it).
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Public network defaults (safe to commit as testnet).
# Mainnet is refused unless NEXT_PUBLIC_GUARD_CONTRACT and NEXT_PUBLIC_NEAR_RPC are both set.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_GUARD_CONTRACT=guard.djume.testnet
NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.near.org
NEXT_PUBLIC_MPC_CONTRACT=v1.signer-prod.testnet
NEXT_PUBLIC_MPC_DOMAIN_ID=1
NEXT_PUBLIC_RELAY_URL=https://relay-production-665a.up.railway.app
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Server-only Privy verification for POST /api/owner-action.
# Owner actions are disabled (503) until both are set. Never prefix SECRET with NEXT_PUBLIC_.
PRIVY_APP_SECRET=
# Optional ES256 PEM from the Privy dashboard (skips a JWKS fetch).
PRIVY_VERIFICATION_KEY=
# Optional comma-separated Solana owner pubkeys. If set, only listed wallets
# may call POST /api/owner-action. If unset, any authenticated Privy user with
# a linked Solana wallet may act (create is still capped below).
OWNER_ALLOWLIST=

# Server-only invite token attached by POST /api/owner-action after Privy auth.
# Optional. The public relay still gates CreateVault/AddAgent; this token lets
# the dashboard self-onboard judges without an owner allowlist.
# Unset = forward without X-Invite-Token (relay decides). Never NEXT_PUBLIC_.
INVITE_TOKEN=

# CreateVault caps (server-side; derived from chain state, not in-memory).
# One vault per owner on the hosted demo (reads owner_vault_count).
MAX_VAULTS_PER_OWNER=1
# VaultView has no created_at/block, so the hosted demo uses a total cap
# (list_vaults count) instead of MAX_RELAY_VAULTS_PER_DAY.
MAX_RELAY_VAULTS_TOTAL=10

# Server-only Attack Lab. Never set NEXT_PUBLIC_ on these.
# Disabled unless account, key, pinned vault, and ATTACK_LAB_TOKEN are all set.
DEMO_AGENT_ACCOUNT_ID=
DEMO_AGENT_PRIVATE_KEY=
DEMO_AGENT_VAULT_ID=
ATTACK_LAB_TOKEN=
